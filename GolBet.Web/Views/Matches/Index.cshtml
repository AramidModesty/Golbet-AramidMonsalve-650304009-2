@* GolBet.Web/Views/Matches/Index.cshtml *@
@* Pray to not code in this cshtml, son of cs and html. *@
@using GolBet.Entities.Enums
@using GolBet.Services.DTOs
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>
@{
    ViewData["Title"] = "Partidos";
}
@{
    var current = (MatchStatus?)ViewBag.CurrentStatus;
    var searchTeam= (string?)ViewBag.SearchTeam;
}
<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index" asp-route-searchTeam=@searchTeam
       class="btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">
        Todos
    </a>
    <a asp-action="Index" asp-route-status="@MatchStatus.Scheduled" asp-route-searchTeam="@searchTeam"
       class="btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">
        Programados
    </a>
    <a asp-action="Index" asp-route-status="@MatchStatus.InProgress" asp-route-searchTeam=@searchTeam"
       class="btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">
        En juego
    </a>
    <a asp-action="Index" asp-route-status="@MatchStatus.Finished" asp-route-searchTeam=@searchTeam"
       class="btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">
        Finalizados
    </a>
    <form asp-action="Index">
        <div>
            <label for="searchTeam">Buscar por equipo</label>
            @*type: var type received, id: variable user changes,
            name: where the server action receives the value(bag),
            value: the value that the server receives.(fun(args))
            for, id, and name are called the same most if not every time.*@
            <input type="text" id="searchTeam" name="searchTeam" value="@searchTeam"/>
            <input type="text" id="status" name="status" value="@current" hidden/>
            @*class is just for style points.*@
            <button type="submit" class="btn btn-success">confirmar</button>
        </div>
    </form>
    @*This is the old feature of match precise search. It is outclassed for the moment.
    Kinda makes one wish we knew about conditionals for dates in databases. Couldn't be me
    (Would be implementing in repository of databaselimInf<matchDate<limSup).
    Please ignore this one and focus on the main thing*@
    <a asp-action="IndexByTeams" class="btn btn-outline-success">
        Busqueda precisa (por implementar)
    </a>
</div>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>⚽ Cartelera de partidos</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">+ Nuevo partido</a>
    }
</div>

 
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
@foreach (MatchDto match in Model)
{
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    📅 @match.Date.ToColombiaTime().ToString("ddd dd MMM · h:mm tt")
                </small>
                @switch (match.Status)
                {
                    case MatchStatus.Scheduled:
                        <span class="badge bg-primary">Programado</span>
                        break;
                    case MatchStatus.InProgress:
                        <span class="badge bg-warning text-dark">En juego</span>
                        break;
                    case MatchStatus.Finished:
                        <span class="badge bg-secondary">Finalizado</span>
                        break;
                }
            </div>

            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center text-center">
                    <div class="w-100">
                        <img src="@(match.HomeTeamCrestUrl ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC")"
                            alt="@match.HomeTeamName" width="60" height="60" class="mb-1" />
                        <div class="fw-bold small">@match.HomeTeamName</div>
                    </div>

                    <div class="px-3 text-nowrap">
                        @if (match.Status == MatchStatus.Finished)
                        {
                            <span class="fs-3 fw-bold">@match.HomeGoals - @match.AwayGoals</span>
                        }
                        else
                        {
                            <span class="fs-4 text-muted">vs</span>
                        }
                    </div>

                    <div class="w-100">
                        <img src="@(match.AwayTeamCrestUrl ?? "https://placehold.co/60x60?text=⚽")"
                            alt="@match.AwayTeamName" width="60" height="60" class="mb-1" />
                        <div class="fw-bold small">@match.AwayTeamName</div>
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <div class="row g-2 text-center">
                    <div class="col">
                        <div class="border rounded py-1">
                            <small class="text-muted d-block">1 · Local</small>
                            <span class="fw-bold">@match.HomeOdds.ToString("0.00")</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="border rounded py-1">
                            <small class="text-muted d-block">X · Empate</small>
                            <span class="fw-bold">@match.DrawOdds.ToString("0.00")</span>
                        </div>
                        <a asp-action="Detail" asp-route-id="@match.Id"
                        class="btn btn-sm btn-outline-secondary w-100 mt-2">
                            Ver detalle
                        </a>
                    </div>
                    <div class="col">
                        <div class="border rounded py-1">
                            <small class="text-muted d-block">2 · Visitante</small>
                            <span class="fw-bold">@match.AwayOdds.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</div>
